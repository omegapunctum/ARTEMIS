  "$defs": {
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "place_id",
        "label",
        "place_kind",
        "geometry",
        "claim_refs"
      ],
      "properties": {
        "place_id": {
          "type": "string",
          "pattern": "^place-"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "place_kind": {
          "enum": [
            "settlement",
            "city",
            "named_complex",
            "named_residence"
          ]
        },
        "geometry": {
          "type": "null"
        },
        "claim_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^claim-"
          },
          "uniqueItems": true
        }
      }
    },
    "macroPeriod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period_id",
        "label",
        "display_range",
        "presentation_only",
        "presence_refs"
      ],
      "properties": {
        "period_id": {
          "type": "string",
          "pattern": "^period-leonardo-"
        },
        "label": {

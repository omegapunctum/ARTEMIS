        "presentation_only": {
          "const": true
        },
        "presence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^presence-leonardo-"
          },
          "uniqueItems": true
        }
      }
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_native",
        "start",
        "end",
        "precision",
        "extent_semantics",
        "start_qualifier",
        "end_qualifier",
        "start_inclusive",
        "end_inclusive"
      ],
      "properties": {
        "source_native": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "string",
          "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
        },
        "end": {
          "type": "string",
          "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
        },
        "precision": {
          "enum": [
            "day",
            "year",
            "year_range_with_approximate_year_locator",
            "bounded_season_start_and_day_end"
          ]
        },
        "extent_semantics": {
          "enum": [
            "documented_presence_anchor",
            "documentary_context_anchor",
            "source_native_manuscript_anchor",
            "residence_range_not_continuous_position"
          ]
        },
        "start_qualifier": {
          "enum": [
            "exact",
            "not_before",
            "source_context_year"
          ]
        },
        "end_qualifier": {
          "enum": [
            "exact",
            "not_after",
            "source_context_year"
          ]
        },
        "start_inclusive": {
          "type": "boolean"
        },
        "end_inclusive": {
          "type": "boolean"
        }
      }
    },
    "presence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "presence_id",
        "period_ref",
        "place_ref",
        "place_label",
        "activity_label",
        "selection_rationale",
        "temporal",
        "spatial_precision",
        "geometry",
        "claim_refs",
        "uncertainty_refs",
        "audit_decision"
      ],
      "properties": {
        "presence_id": {
          "type": "string",
          "pattern": "^presence-leonardo-"
        },
        "period_ref": {
          "type": "string",
          "pattern": "^period-leonardo-"
        },
        "place_ref": {
          "type": "string",
          "pattern": "^place-"
        },
        "place_label": {
          "type": "string",
          "minLength": 1
        },
        "activity_label": {
          "type": "string",
          "minLength": 1
        },
        "selection_rationale": {
          "type": "string",
          "minLength": 1
        },
        "temporal": {
          "$ref": "#/$defs/temporal"
        },
        "spatial_precision": {
          "enum": [
            "named_settlement",
            "named_city",
            "named_city_with_institutional_context",
            "named_city_with_parish_context",
            "named_complex",
            "named_residence"
          ]
        },
        "geometry": {
          "type": "null"
        },
        "claim_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^claim-"
          },
          "uniqueItems": true
        },
        "uncertainty_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^uncertainty-"
          },
          "uniqueItems": true
        },
        "audit_decision": {
          "const": "READY_FOR_CANONICAL_REVIEW"
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_id",
        "from_ref",
        "to_ref",
        "route_status",
        "geometry",
        "source_refs"
      ],
      "properties": {
        "transition_id": {
          "type": "string",
          "pattern": "^transition-"
        },
        "from_ref": {
          "type": "string",
          "minLength": 1
        },
        "to_ref": {
          "type": "string",
          "minLength": 1
        },
        "route_status": {
          "const": "unknown_route"
        },
        "geometry": {
          "type": "null"
        },
        "source_refs": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_text_use",
        "media_reuse",
        "derived_geometry_use"
      ],
      "properties": {
        "data_text_use": {
          "const": "citation_and_factual_claims_only"
        },
        "media_reuse": {

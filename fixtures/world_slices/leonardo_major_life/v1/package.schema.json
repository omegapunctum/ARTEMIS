        "derived_geometry_use": {
          "const": "prohibited"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "title",
        "organization",
        "source_type",
        "review_state",
        "url",
        "locator",
        "rights"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^source-"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "organization": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "type": "string",
          "minLength": 1
        },
        "review_state": {
          "const": "reviewed"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "rights": {
          "$ref": "#/$defs/rights"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "target_ref",
        "claim_dimension",
        "statement",
        "claim_kind",
        "origin",
        "review_state",
        "confidence",
        "evidence_state",
        "evidence_link_refs",
        "uncertainty_refs"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^claim-"
        },
        "target_ref": {
          "type": "string",
          "pattern": "^presence-leonardo-"
        },
        "claim_dimension": {
          "enum": [
            "identity",
            "time",
            "place",
            "selection_significance"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "claim_kind": {
          "enum": [
            "factual",
            "interpretation"
          ]
        },
        "origin": {
          "const": "curator"
        },
        "review_state": {
          "const": "reviewed"
        },
        "confidence": {
          "enum": [
            "high",
            "medium"
          ]
        },
        "evidence_state": {
          "const": "supported"
        },
        "evidence_link_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^evidence-"
          },
          "uniqueItems": true
        },
        "uncertainty_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^uncertainty-"
          },
          "uniqueItems": true
        }
      }
    },
    "evidenceLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_link_id",
        "claim_id",
        "source_id",
        "relation_to_claim",
        "evidence_strength",
        "reviewer",
        "locator",
        "review_state"
      ],
      "properties": {
        "evidence_link_id": {
          "type": "string",
          "pattern": "^evidence-"
        },
        "claim_id": {
          "type": "string",
          "pattern": "^claim-"
        },
        "source_id": {
          "type": "string",
          "pattern": "^source-"
        },
        "relation_to_claim": {
          "enum": [
            "supports",
            "contextualizes"
          ]
        },
        "evidence_strength": {
          "enum": [
            "direct",
            "indirect",
            "background"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 12
        },
        "review_state": {
          "const": "reviewed"
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uncertainty_id",
        "target_refs",
        "dimension",
        "description",
        "effect",
        "basis_claim_refs",
        "evidence_state",
        "projection_effect",
        "possible_bounds"
      ],
      "properties": {
        "uncertainty_id": {
          "type": "string",
          "pattern": "^uncertainty-"
        },
        "target_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "dimension": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "effect": {
          "type": "string",
          "minLength": 1
        },
        "basis_claim_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^claim-"
          },
          "uniqueItems": true
        },
        "evidence_state": {
          "enum": [
            "explicit_missing_exactness_evidence",
            "explicit_missing_route_evidence"
          ]
        },
        "projection_effect": {
          "enum": [
            "show_possible",
            "show_unknown",
            "prohibit_geometry"
          ]
        },
        "possible_bounds": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "not_before",
                "not_after",
                "start_inclusive",
                "end_inclusive"
              ],
              "properties": {
                "not_before": {
                  "type": "string",
                  "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
                },
                "not_after": {
                  "type": "string",
                  "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
                },
                "start_inclusive": {
                  "type": "boolean"
                },
                "end_inclusive": {
                  "type": "boolean"
                }
              }
            }
          ]
        }
      }
    }
  }

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artemis.example/schemas/leonardo-romagna-claims-v1.json",
  "title": "ARTEMIS Leonardo-in-Romagna atomic claim curation manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "slice_id", "status", "claims", "evidence_links", "uncertainties"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "slice_id": {"const": "world-slice-leonardo-romagna-1502-v1"},
    "status": {"const": "CLAIM_CURATION_IN_PROGRESS"},
    "claims": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id", "statement", "target_object_ref", "claim_kind", "origin",
          "review_state", "confidence", "confidence_basis", "evidence_state",
          "evidence_link_refs", "uncertainty_refs"
        ],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^claim-[a-z0-9-]+$"},
          "statement": {"type": "string", "minLength": 15},
          "target_object_ref": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
          "claim_kind": {"enum": ["factual", "observation", "inference", "interpretation", "hypothesis", "counterfactual"]},
          "origin": {"enum": ["curator", "system", "imported"]},
          "review_state": {"enum": ["draft", "reviewed", "contested", "rejected", "superseded"]},
          "confidence": {"enum": ["high", "medium", "low", "unknown"]},
          "confidence_basis": {"type": "string", "minLength": 1},
          "evidence_state": {"enum": ["supported", "mixed", "challenged", "missing", "not_applicable"]},
          "evidence_link_refs": {"$ref": "#/$defs/refArray"},
          "uncertainty_refs": {"$ref": "#/$defs/refArray"}
        }
      }
    },
    "evidence_links": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_link_id", "claim_id", "source_id", "locator",
          "relation_to_claim", "evidence_strength", "review_state", "reviewer"
        ],
        "properties": {
          "evidence_link_id": {"type": "string", "pattern": "^evidence-[a-z0-9-]+$"},
          "claim_id": {"type": "string", "pattern": "^claim-[a-z0-9-]+$"},
          "source_id": {"type": "string", "pattern": "^source-[a-z0-9-]+$"},
          "locator": {"type": "string", "minLength": 12},
          "relation_to_claim": {"enum": ["supports", "challenges", "contextualizes"]},
          "evidence_strength": {"enum": ["direct", "indirect", "background"]},
          "review_state": {"enum": ["draft", "reviewed", "contested", "rejected", "superseded"]},
          "reviewer": {"type": ["string", "null"]}
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uncertainty_id", "dimension", "description", "effect", "basis_kind", "basis", "basis_claim_refs", "review_state", "target_refs"],
        "properties": {
          "uncertainty_id": {"type": "string", "pattern": "^uncertainty-[a-z0-9-]+$"},
          "dimension": {"enum": ["date", "location", "source", "reconstruction", "missing_evidence", "scope_limitation"]},
          "description": {"type": "string", "minLength": 12},
          "effect": {"type": "string", "minLength": 12},
          "basis_kind": {"enum": ["claim_refs", "explicit_missing_evidence", "scope_policy"]},
          "basis": {"type": "string", "minLength": 12},
          "basis_claim_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^claim-[a-z0-9-]+$"}
          },
          "review_state": {"enum": ["draft", "reviewed", "contested", "rejected", "superseded"]},
          "target_refs": {"$ref": "#/$defs/refArray"}
        }
      }
    }
  },
  "$defs": {
    "refArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"}
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artemis.example/schemas/leonardo-world-slice-cost-v1.json",
  "title": "ARTEMIS Leonardo World Slice curation cost log v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "slice_id", "status", "unit", "entries", "ready_rule"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "slice_id": {"const": "world-slice-leonardo-romagna-1502-v1"},
    "status": {"const": "CURATION_IN_PROGRESS"},
    "unit": {"const": "minutes"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["activity_id", "activity", "actor_kind", "duration_minutes", "measurement_state", "notes"],
        "properties": {
          "activity_id": {"type": "string", "pattern": "^cost-[a-z0-9-]+$"},
          "activity": {"type": "string", "minLength": 1},
          "actor_kind": {"enum": ["agent_assisted", "human_curator", "independent_reviewer"]},
          "duration_minutes": {"type": ["integer", "null"], "minimum": 0},
          "measurement_state": {"enum": ["pending", "recorded"]},
          "notes": {"type": "string", "minLength": 1}
        }
      }
    },
    "ready_rule": {"const": "Every entry must be measured and review cost must be recorded before READY."}
  }
}

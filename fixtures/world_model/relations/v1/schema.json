{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artemis.example.invalid/schemas/relation-ladder-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "fixture_mode",
    "status",
    "record_time",
    "base_packages",
    "relation_predicates",
    "place_hierarchy",
    "sources",
    "claims",
    "evidence_links",
    "uncertainties",
    "cases",
    "non_relation_cases",
    "promotion_rules",
    "ui_language_rules"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "package_id": {"const": "artemis-relation-ladder-v1"},
    "fixture_mode": {"const": "synthetic_contract_fixture"},
    "status": {"enum": ["REVIEW_REQUIRED", "READY"]},
    "record_time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_at", "reviewed_at"],
      "properties": {
        "created_at": {"type": "string", "format": "date-time"},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "base_packages": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/basePackage"}},
    "relation_predicates": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/predicate"}},
    "place_hierarchy": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/placeParent"}},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "claims": {"type": "array", "minItems": 9, "items": {"$ref": "#/$defs/claim"}},
    "evidence_links": {"type": "array", "minItems": 7, "items": {"$ref": "#/$defs/evidence"}},
    "uncertainties": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/uncertainty"}},
    "cases": {"type": "array", "minItems": 13, "items": {"$ref": "#/$defs/case"}},
    "non_relation_cases": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/nonRelation"}},
    "promotion_rules": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/promotion"}},
    "ui_language_rules": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/uiRule"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "refs": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
    "basePackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_id", "registry_path", "status", "frozen_commit", "reviewed_content_sha256"],
      "properties": {
        "package_id": {"$ref": "#/$defs/id"},
        "registry_path": {"type": "string"},
        "status": {"const": "READY"},
        "frozen_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "reviewed_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "family", "storage_kind", "definition", "minimum_basis", "directionality", "requires_co_presence"],
      "properties": {
        "id": {"enum": ["co_present", "possible_encounter", "documented_encounter", "interaction", "influence", "causal"]},
        "family": {"enum": ["derived_proximity", "encounter_inference", "documented_contact", "documented_action", "historical_effect", "causal_explanation"]},
        "storage_kind": {"enum": ["computed_observation", "explicit_inference", "relation_claim"]},
        "definition": {"type": "string", "minLength": 20},
        "minimum_basis": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "directionality": {"enum": ["symmetric", "directed_or_symmetric", "directed"]},
        "requires_co_presence": {"type": "boolean"}
      }
    },
    "placeParent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["child_ref", "parent_ref"],
      "properties": {"child_ref": {"$ref": "#/$defs/id"}, "parent_ref": {"$ref": "#/$defs/id"}}
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "title", "source_type", "review_state", "fixture_only"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "path": {"type": "string"},
        "title": {"type": "string"},
        "source_type": {"const": "synthetic_fixture"},
        "review_state": {"const": "reviewed"},
        "fixture_only": {"const": true}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target_ref", "subject_ref", "predicate", "object_ref", "statement", "qualifiers", "claim_kind", "origin", "review_state", "confidence", "evidence_state", "assertion_sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "target_ref": {"$ref": "#/$defs/id"},
        "subject_ref": {"$ref": "#/$defs/id"},
        "predicate": {"enum": ["possible_encounter", "documented_encounter", "interaction", "influence", "causal", "causal_basis"]},
        "object_ref": {"$ref": "#/$defs/id"},
        "statement": {"type": "string", "minLength": 20},
        "qualifiers": {"type": "object"},
        "claim_kind": {"enum": ["factual", "inference", "interpretation"]},
        "origin": {"enum": ["curator", "system"]},
        "review_state": {"enum": ["draft", "reviewed", "contested"]},
        "confidence": {"enum": ["high", "medium", "low", "unknown"]},
        "evidence_state": {"enum": ["supported", "missing", "not_applicable"]},
        "assertion_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claim_id", "source_id", "locator", "relation_to_claim", "evidence_strength", "review_state"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "claim_id": {"$ref": "#/$defs/id"},
        "source_id": {"$ref": "#/$defs/id"},
        "locator": {"type": "string", "pattern": "^LOCATOR\\[[a-z0-9-]+\\]$"},
        "relation_to_claim": {"enum": ["supports", "challenges", "contextualizes"]},
        "evidence_strength": {"enum": ["direct", "indirect", "background"]},
        "review_state": {"const": "reviewed"}
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject_claim_ref", "dimension", "description", "effect"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "subject_claim_ref": {"$ref": "#/$defs/id"},
        "dimension": {"const": "relation"},
        "description": {"type": "string", "minLength": 10},
        "effect": {"type": "string", "minLength": 10}
      }
    },
    "bound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "precision", "qualifier", "inclusive"],
      "properties": {
        "value": {"type": "string", "minLength": 4},
        "precision": {"enum": ["year", "month", "day"]},
        "qualifier": {"enum": ["exact", "not_before", "not_after", "approximate_start", "approximate_end"]},
        "inclusive": {"type": "boolean"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "lower", "upper", "basis_claim_refs"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["instant", "closed_interval", "bounded_interval", "open_start_interval", "open_end_interval", "approximate", "unknown"]},
        "lower": {"oneOf": [{"$ref": "#/$defs/bound"}, {"type": "null"}]},
        "upper": {"oneOf": [{"$ref": "#/$defs/bound"}, {"type": "null"}]},
        "basis_claim_refs": {"$ref": "#/$defs/refs"}
      }
    },
    "spatialCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mode", "geometry", "basis_claim_refs", "uncertainty_refs", "projection_policy"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "mode": {"enum": ["exact_point", "approximate_point", "named_place", "unknown", "documented_path", "inferred_corridor", "unknown_route"]},
        "geometry": {"type": ["object", "null"]},
        "place_ref": {"$ref": "#/$defs/id"},
        "endpoint_refs": {"$ref": "#/$defs/refs"},
        "tolerance_m": {"type": "number", "exclusiveMinimum": 0},
        "basis_claim_refs": {"$ref": "#/$defs/refs"},
        "uncertainty_refs": {"$ref": "#/$defs/refs"},
        "projection_policy": {"$ref": "#/$defs/id"}
      }
    },
    "presence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entity_ref", "temporal_candidates", "spatial_candidates", "uncertainty_refs"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "entity_ref": {"$ref": "#/$defs/id"},
        "temporal_candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}},
        "spatial_candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/spatialCase"}},
        "uncertainty_refs": {"$ref": "#/$defs/refs"}
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "state"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "statement": {"type": "string", "minLength": 10},
        "state": {"enum": ["declared", "challenged"]}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fixture_role", "subject_ref", "object_ref", "presence_extents", "co_presence_result", "asserted_predicate", "relation_claim_ref", "assumptions", "uncertainty_refs", "causal_basis_claim_ref", "causal_policy_ref"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "fixture_role": {"enum": ["positive", "negative", "ambiguous"]},
        "subject_ref": {"$ref": "#/$defs/id"},
        "object_ref": {"$ref": "#/$defs/id"},
        "presence_extents": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/presence"}},
        "co_presence_result": {"enum": ["confirmed", "possible", "excluded", "unknown"]},
        "asserted_predicate": {"enum": ["none", "co_present", "possible_encounter", "documented_encounter", "interaction", "influence", "causal"]},
        "relation_claim_ref": {"type": ["string", "null"]},
        "assumptions": {"type": "array", "items": {"$ref": "#/$defs/assumption"}},
        "uncertainty_refs": {"$ref": "#/$defs/refs"},
        "causal_basis_claim_ref": {"type": ["string", "null"]},
        "causal_policy_ref": {"type": ["string", "null"]}
      }
    },
    "nonRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "signal_kind", "subject_ref", "object_ref", "projection", "creates_relation"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "signal_kind": {"enum": ["classification", "similarity"]},
        "subject_ref": {"$ref": "#/$defs/id"},
        "object_ref": {"$ref": "#/$defs/id"},
        "projection": {"type": "string"},
        "creates_relation": {"const": false}
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "rule_kind", "automatic", "required_basis"],
      "properties": {
        "from": {"enum": ["co_present", "possible_encounter", "documented_encounter", "interaction", "influence"]},
        "to": {"enum": ["possible_encounter", "documented_encounter", "interaction", "influence", "causal"]},
        "rule_kind": {"enum": ["conditional_derivation", "independent_predicate_evidence"]},
        "automatic": {"const": false},
        "required_basis": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "uiRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicate", "required_label", "forbidden_phrases", "source_access_required"],
      "properties": {
        "predicate": {"enum": ["co_present", "possible_encounter", "documented_encounter", "interaction", "influence", "causal"]},
        "required_label": {"type": "string", "minLength": 10},
        "forbidden_phrases": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "source_access_required": {"type": "boolean"}
      }
    }
  }
}

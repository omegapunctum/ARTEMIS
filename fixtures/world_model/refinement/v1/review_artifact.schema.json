{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artemis.example/schemas/progressive-refinement-review-artifact-v1.json",
  "title": "ARTEMIS progressive refinement independent review artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "review_round",
    "review_id",
    "reviewer_id",
    "reviewer_instance_id",
    "review_task_path",
    "track",
    "independence_method",
    "frozen_commit",
    "frozen_tree",
    "reviewed_content_sha256",
    "decision",
    "open_critical",
    "open_material",
    "findings",
    "commands",
    "conclusion"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "package_id": {"const": "artemis-progressive-refinement-v1"},
    "review_round": {"type": "integer", "minimum": 1},
    "review_id": {"type": "string", "pattern": "^refinement-v1-[a-z0-9-]+$"},
    "reviewer_id": {"type": "string", "minLength": 1},
    "reviewer_instance_id": {"type": "string", "minLength": 1},
    "review_task_path": {"type": "string", "minLength": 1},
    "track": {"enum": ["semantic-model", "validator-integrity"]},
    "independence_method": {"const": "separate_agent_task_read_only"},
    "frozen_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "frozen_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "reviewed_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision": {"enum": ["READY", "CHANGES_REQUIRED"]},
    "open_critical": {"type": "integer", "minimum": 0},
    "open_material": {"type": "integer", "minimum": 0},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "severity", "status", "summary"],
        "properties": {
          "finding_id": {"type": "string", "minLength": 1},
          "severity": {"enum": ["critical", "material", "minor", "informational"]},
          "status": {"enum": ["open", "resolved", "accepted"]},
          "summary": {"type": "string", "minLength": 1}
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "conclusion": {"type": "string", "minLength": 20}
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "READY"}}},
      "then": {
        "properties": {
          "open_critical": {"const": 0},
          "open_material": {"const": 0}
        }
      }
    }
  ]
}

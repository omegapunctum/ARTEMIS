{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artemis.example/schemas/progressive-refinement-review-request-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "issue", "pull_request", "review_round",
    "required_tracks", "independence_method", "review_slots", "review_scope", "acceptance"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "status": {"const": "REVIEW_REQUIRED"},
    "issue": {"const": 377},
    "pull_request": {"const": 378},
    "review_round": {"const": 9},
    "required_tracks": {"const": ["semantic-model", "validator-integrity"]},
    "independence_method": {"const": "separate_agent_task_read_only"},
    "review_slots": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewer_id", "reviewer_instance_id", "review_task_path", "track"],
        "properties": {
          "reviewer_id": {"type": "string", "minLength": 1},
          "reviewer_instance_id": {"type": "string", "minLength": 1},
          "review_task_path": {"type": "string", "pattern": "^/root/refinement_[a-z0-9_]+_r9$"},
          "track": {"enum": ["semantic-model", "validator-integrity"]}
        }
      }
    },
    "review_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_review_count", "allowed_decisions", "ready_requires_open_critical",
        "ready_requires_open_material", "artifact_schema", "registry", "decision"
      ],
      "properties": {
        "required_review_count": {"const": 2},
        "allowed_decisions": {"const": ["READY", "CHANGES_REQUIRED"]},
        "ready_requires_open_critical": {"const": 0},
        "ready_requires_open_material": {"const": 0},
        "artifact_schema": {"const": "fixtures/world_model/refinement/v1/review_artifact.schema.json"},
        "registry": {"const": "fixtures/world_model/refinement/v1/review_registry.json"},
        "decision": {"const": "fixtures/world_model/refinement/v1/acceptance_decision.json"}
      }
    }
  }
}

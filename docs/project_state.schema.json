{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artemis.example/schemas/project-state-v1.1.json",
  "title": "ARTEMIS machine-readable operational state v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "updated_at",
    "north_star_ref",
    "active_vertical",
    "phase",
    "completed_gates",
    "gate",
    "work_in_progress_limit",
    "github",
    "capability",
    "canonical_refs",
    "blockers",
    "next_transition"
  ],
  "$defs": {
    "gateCEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frozen_commit", "frozen_tree", "reviewed_content_digest", "review_registry_ref", "gate_decision_ref", "review_cost_ref"],
      "properties": {
        "frozen_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "frozen_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "reviewed_content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "review_registry_ref": {"const": "fixtures/world_slices/leonardo_romagna_1502/v1/review_registry.json"},
        "gate_decision_ref": {"const": "fixtures/world_slices/leonardo_romagna_1502/v1/gate_c_decision.json"},
        "review_cost_ref": {"const": "fixtures/world_slices/leonardo_romagna_1502/v1/curation_cost.json"}
      }
    },
    "completedGateC": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "status", "allowed_decisions", "decision", "next_gate", "evidence"],
      "properties": {
        "id": {"const": "C"},
        "label": {"type": "string", "minLength": 1},
        "status": {"const": "completed"},
        "allowed_decisions": {"const": ["FREEZE", "NARROW", "REJECT"]},
        "decision": {"enum": ["FREEZE", "NARROW", "REJECT"]},
        "next_gate": {"const": "D"},
        "evidence": {"$ref": "#/$defs/gateCEvidence"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "project": {"const": "ARTEMIS"},
    "updated_at": {"type": "string", "format": "date"},
    "north_star_ref": {"const": "docs/ARTEMIS_CONCEPT.md"},
    "active_vertical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "issue"],
      "properties": {
        "id": {"const": "life-in-context-globe-mvp"},
        "label": {"type": "string", "minLength": 1},
        "issue": {"const": 355}
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": {"const": "5.0"},
        "status": {"const": "active"}
      }
    },
    "completed_gates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"$ref": "#/$defs/completedGateC"}
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "status", "allowed_decisions"],
      "properties": {
        "id": {"enum": ["D", "E"]},
        "label": {"type": "string", "minLength": 1},
        "status": {"enum": ["in_progress", "blocked"]},
        "allowed_decisions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "decision": {"enum": ["ADOPT", "NARROW", "REJECT"]}
      }
    },
    "work_in_progress_limit": {"const": 1},
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_issues", "paused_issues", "deferred_issues", "superseded_issues", "completed_issues", "completed_prerequisites"],
      "properties": {
        "active_issues": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer"}},
        "paused_issues": {"type": "array", "uniqueItems": true, "items": {"type": "integer"}},
        "deferred_issues": {"type": "array", "uniqueItems": true, "items": {"type": "integer"}},
        "superseded_issues": {"type": "array", "uniqueItems": true, "items": {"type": "integer"}},
        "completed_issues": {"type": "array", "uniqueItems": true, "items": {"type": "integer"}},
        "completed_prerequisites": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_runtime", "globe", "world_slice"],
      "properties": {
        "public_runtime": {"const": "core_landing_globe_primary_atlas_compatibility"},
        "globe": {"const": "public_r_and_d_preview"},
        "world_slice": {"enum": ["scope_curation", "gate_c_frozen_non_public", "gate_c_rejected_non_public", "projected_non_public"]}
      }
    },
    "canonical_refs": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^docs/"}
    },
    "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "next_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "condition"],
      "properties": {
        "gate": {"enum": ["D", "E", "STOP"]},
        "condition": {"type": "string", "minLength": 1}
      }
    }
  }
}

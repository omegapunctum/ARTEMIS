{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artemis.example/schemas/project-state-v1.12.json",
  "title": "ARTEMIS machine-readable operational state v1.12",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "updated_at",
    "north_star_ref",
    "active_vertical",
    "phase",
    "completed_gates",
    "gate",
    "current_checkpoint",
    "architecture_checkpoint",
    "ux_correction_checkpoint",
    "gate_review",
    "gate_e",
    "work_in_progress_limit",
    "github",
    "capability",
    "canonical_refs",
    "blockers",
    "next_transition"
  ],
  "$defs": {
    "gateCEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frozen_commit", "frozen_tree", "reviewed_content_digest", "review_registry_ref", "gate_decision_ref", "review_cost_ref"],
      "properties": {
        "frozen_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "frozen_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "reviewed_content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "review_registry_ref": {"const": "fixtures/world_slices/leonardo_romagna_1502/v1/review_registry.json"},
        "gate_decision_ref": {"const": "fixtures/world_slices/leonardo_romagna_1502/v1/gate_c_decision.json"},
        "review_cost_ref": {"const": "fixtures/world_slices/leonardo_romagna_1502/v1/curation_cost.json"}
      }
    },
    "completedGateC": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "status", "allowed_decisions", "decision", "next_gate", "evidence"],
      "properties": {
        "id": {"const": "C"},
        "label": {"type": "string", "minLength": 1},
        "status": {"const": "completed"},
        "allowed_decisions": {"const": ["FREEZE", "NARROW", "REJECT"]},
        "decision": {"enum": ["FREEZE", "NARROW", "REJECT"]},
        "next_gate": {"const": "D"},
        "evidence": {"$ref": "#/$defs/gateCEvidence"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "1.12.0"},
    "project": {"const": "ARTEMIS"},
    "updated_at": {"type": "string", "format": "date"},
    "north_star_ref": {"const": "docs/ARTEMIS_CONCEPT.md"},
    "active_vertical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "issue"],
      "properties": {
        "id": {"const": "life-in-context-globe-mvp"},
        "label": {"type": "string", "minLength": 1},
        "issue": {"const": 355}
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": {"const": "5.1"},
        "status": {"const": "active"}
      }
    },
    "completed_gates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"$ref": "#/$defs/completedGateC"}
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "status", "allowed_decisions"],
      "properties": {
        "id": {"enum": ["D", "E"]},
        "label": {"type": "string", "minLength": 1},
        "status": {"enum": ["in_progress", "blocked", "completed"]},
        "allowed_decisions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "decision": {"enum": ["ADVANCE_TO_GATE_E", "NARROW", "REJECT"]},
        "evidence_ref": {"const": "docs/work/2026-09-06_GATE_D_EXIT_DECISION_v1.md"}
      }
    },
    "current_checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "kind",
        "status",
        "allowed_decisions",
        "implementation_pr",
        "merged_commit",
        "published_url",
        "entry_authority",
        "pre_start_decision_record",
        "governance_alignment_ref"
      ],
      "properties": {
        "id": {"const": "M5"},
        "label": {"const": "Whole-Life Runtime Proof"},
        "kind": {"const": "bounded_runtime_proof"},
        "status": {"enum": ["awaiting_manual_product_check", "completed"]},
        "allowed_decisions": {"const": ["ITERATE", "NARROW", "STOP"]},
        "decision": {"enum": ["ITERATE", "NARROW", "STOP"]},
        "implementation_pr": {"const": 406},
        "merged_commit": {"const": "24243b7ff09029bddedc3592c2ef2963813f146d"},
        "published_url": {"const": "https://omegapunctum.github.io/ARTEMIS/globe/?mode=range&start=1452&end=1519"},
        "entry_authority": {"const": "explicit_owner_instruction"},
        "pre_start_decision_record": {"const": false},
        "governance_alignment_ref": {"const": "docs/work/2026-09-03_TEMPORAL_MAP_M5_GOVERNANCE_ALIGNMENT_v1.md"}
      }
    },
    "architecture_checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "allowed_decisions", "decision", "evidence_ref"],
      "properties": {
        "id": {"const": "M4"}, "status": {"const": "completed"},
        "allowed_decisions": {"const": ["ADOPT", "NARROW", "REJECT"]},
        "decision": {"const": "ADOPT"},
        "evidence_ref": {"const": "docs/work/2026-09-01_TEMPORAL_MAP_M4_ARCHITECTURE_DECISION_v1.md"}
      }
    },
    "ux_correction_checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "allowed_decisions", "decision", "implementation_prs", "merged_commit", "acceptance_kind", "accepted_at", "evidence_ref"],
      "properties": {
        "id": {"const": "M5_BOUNDED_UX_CORRECTION"}, "status": {"const": "completed"},
        "allowed_decisions": {"const": ["PROCEED_TO_GATE_D_REVIEW", "ITERATE", "NARROW", "STOP"]},
        "decision": {"const": "PROCEED_TO_GATE_D_REVIEW"},
        "implementation_prs": {"const": [411, 412]},
        "merged_commit": {"const": "d100f2cb09d743c31184c4a4b33b32258678b929"},
        "acceptance_kind": {"const": "owner_acceptance_report"},
        "accepted_at": {"type": "string", "format": "date"},
        "evidence_ref": {"const": "docs/work/2026-09-06_M5_UX_CLOSEOUT_AND_GATE_D_REVIEW_v1.md"}
      }
    },
    "gate_review": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "recommendation", "material_implementation_gaps", "exit_record_ref", "evidence_ref"],
      "properties": {
        "status": {"const": "bounded_review_completed_exit_recorded"},
        "recommendation": {"const": "ADVANCE_TO_GATE_E"},
        "material_implementation_gaps": {"type": "array", "items": {"type": "string"}},
        "exit_record_ref": {"const": "docs/work/2026-09-06_GATE_D_EXIT_DECISION_v1.md"},
        "evidence_ref": {"const": "docs/work/2026-09-06_M5_UX_CLOSEOUT_AND_GATE_D_REVIEW_v1.md"}
      }
    },
    "gate_e": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "disposition",
        "e1",
        "e2",
        "formal_user_value",
        "decision_ref"
      ],
      "properties": {
        "status": {
          "enum": [
            "evidence_recovery_authorized",
            "e1_in_progress",
            "e1_cleared",
            "e2_preparation",
            "e2_in_progress",
            "evidence_complete_awaiting_outcome",
            "closed"
          ]
        },
        "disposition": {
          "enum": ["evidence_recovery", "owner_directed_closeout"]
        },
        "e1": {
          "enum": [
            "ready_not_collected",
            "in_progress",
            "cleared",
            "owner_reported_pass"
          ]
        },
        "e2": {
          "enum": [
            "conditional_not_collected",
            "preparation",
            "in_progress",
            "complete",
            "waived_not_collected"
          ]
        },
        "comparative_user_value": {"const": "unvalidated"},
        "successor_opened": {"const": false},
        "formal_user_value": {
          "const": "unvalidated"
        },
        "decision_ref": {
          "enum": ["docs/work/2026-09-19_GATE_E_EVIDENCE_RECOVERY_SPEC_v1.md", "docs/work/2026-09-23_GATE_E_OWNER_DIRECTED_CLOSEOUT_v1.md"]
        }
      }
    },
    "contextual_composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "research_authorization", "proof_a", "search_disposition", "evidence_provenance", "product_specification_authorized", "implementation_authorized", "successor_opened", "closeout_ref"],
      "properties": {
        "status": {"const": "deferred"},
        "research_authorization": {"const": "contextual_snapshot_candidate_search_v1"},
        "proof_a": {"const": "STOP_PROOF_A"},
        "search_disposition": {"const": "NO_QUALIFYING_SNAPSHOT"},
        "evidence_provenance": {"const": "owner_reported_disposition_only"},
        "product_specification_authorized": {"const": false},
        "implementation_authorized": {"const": false},
        "successor_opened": {"const": false},
        "closeout_ref": {"const": "docs/work/2026-09-24_CONTEXTUAL_SNAPSHOT_CANDIDATE_SEARCH_CLOSEOUT_v1.md"}
      }
    },
    "epistemic_conflict_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "autonomy", "subject", "evidence_state", "decision", "product_ux_disposition", "specification_provenance", "specification_ref", "evidence_verdict", "evidence_package_id", "evidence_package_ref", "evidence_package_blob", "reviewed_pr_head", "evidence_merge_commit", "evidence_review_comment_id", "evidence_closeout_ref", "implementation_started", "numerical_query_envelopes_required", "case_specific_range_scrub_authorized", "runtime_data_promotion_authorized", "implementation_completion", "human_review", "human_review_scope", "implementation_presentation_review", "implementation_pr", "implementation_pr_head", "implementation_merge_commit", "implementation_review_comment_id", "implementation_closeout_ref", "additional_successor_opened", "decision_ref"],
      "properties": {
        "status": {"const": "technical_implementation_completed"},
        "autonomy": {"const": "review_implementation_after_decision"},
        "subject": {"const": "ATL.1466.1 / fol. 733 verso"},
        "evidence_state": {"const": "accepted"},
        "decision": {"const": "NARROW_EPISTEMIC_CONFLICT_PROOF_V1"},
        "product_ux_disposition": {"const": "SPEC_AMENDMENT_READY"},
        "specification_provenance": {"const": "consolidated_owner_handoff_and_accepted_amendment_in_repository"},
        "specification_ref": {"const": "docs/work/2026-09-24_EPISTEMIC_CONFLICT_PROOF_PRODUCT_SPECIFICATION_v1_1.md"},
        "evidence_verdict": {"const": "ACCEPT_EVIDENCE_PACKAGE"},
        "evidence_package_id": {"const": "atl-1466-1-733v-dating-attribution-v1"},
        "evidence_package_ref": {"const": "docs/work/2026-09-24_ATL_1466_1_CONFLICT_EVIDENCE_PACKAGE_v1.md"},
        "evidence_package_blob": {"const": "170d1a7ef2fa5aecd504805d4e5b173d4de16f26"},
        "reviewed_pr_head": {"const": "5e0c86e7dcc985e4ecd38789772c02e55a5021c3"},
        "evidence_merge_commit": {"const": "cd12755ed6442e556524ac5ab12f034c25bf7885"},
        "evidence_review_comment_id": {"const": 5811369499},
        "evidence_closeout_ref": {"const": "docs/work/2026-09-24_EPISTEMIC_CONFLICT_EVIDENCE_ACCEPTANCE_CLOSEOUT_v1.md"},
        "implementation_started": {"const": true},
        "numerical_query_envelopes_required": {"const": false},
        "case_specific_range_scrub_authorized": {"const": false},
        "runtime_data_promotion_authorized": {"const": true},
        "implementation_completion": {"const": "completed_non_public_review_proof"},
        "human_review": {"const": "accepted"},
        "human_review_scope": {"const": "evidence_package_only"},
        "implementation_presentation_review": {"const": "accepted"},
        "implementation_pr": {"const": 453},
        "implementation_pr_head": {"const": "71ea23a223334ec676ff8e1d9fe778785542eacb"},
        "implementation_merge_commit": {"const": "5c421648378d91166c35cc453af1b60e0c39659a"},
        "implementation_review_comment_id": {"const": 5812445343},
        "implementation_closeout_ref": {"const": "docs/work/2026-09-24_EPISTEMIC_CONFLICT_IMPLEMENTATION_CLOSEOUT_v1.md"},
        "additional_successor_opened": {"const": false},
        "decision_ref": {"const": "docs/work/2026-09-24_EPISTEMIC_CONFLICT_PROOF_AUTHORIZATION_v1.md"}
      }
    },
    "region_closeout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "publication",
        "interactive_owner_review",
        "acceptance_kind",
        "recorded_at",
        "provenance_license_finding",
        "reconstruction_limits_finding",
        "retest",
        "generality",
        "successor_opened",
        "evidence_ref"
      ],
      "properties": {
        "implementation": {
          "const": "completed"
        },
        "publication": {
          "const": "verified"
        },
        "interactive_owner_review": {
          "const": "completed"
        },
        "acceptance_kind": {
          "const": "human_owner_retest_report"
        },
        "recorded_at": {
          "type": "string",
          "format": "date"
        },
        "provenance_license_finding": {
          "const": "resolved"
        },
        "reconstruction_limits_finding": {
          "const": "resolved"
        },
        "retest": {
          "const": "PASS"
        },
        "generality": {
          "const": "technical_only"
        },
        "successor_opened": {
          "const": false
        },
        "evidence_ref": {
          "const": "docs/work/2026-09-19_REGION_OWNER_RETEST_CLOSEOUT_v1.md"
        }
      }
    },
    "work_in_progress_limit": {"const": 1},
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_issues", "paused_issues", "deferred_issues", "superseded_issues", "completed_issues", "completed_prerequisites"],
      "properties": {
        "active_issues": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer"}},
        "paused_issues": {"type": "array", "uniqueItems": true, "items": {"type": "integer"}},
        "deferred_issues": {"type": "array", "uniqueItems": true, "items": {"type": "integer"}},
        "superseded_issues": {"type": "array", "uniqueItems": true, "items": {"type": "integer"}},
        "completed_issues": {"type": "array", "uniqueItems": true, "items": {"type": "integer"}},
        "completed_prerequisites": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_runtime", "globe", "world_slice", "temporal_map"],
      "properties": {
        "public_runtime": {"const": "core_landing_globe_primary_atlas_compatibility_region_separate_public_r_and_d_preview"},
        "globe": {"const": "public_r_and_d_preview"},
        "world_slice": {"enum": ["scope_curation", "gate_c_frozen_non_public", "gate_c_rejected_non_public", "projected_non_public"]},
        "temporal_map": {"const": "m5_whole_life_runtime_proof_published"}
      }
    },
    "canonical_refs": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^docs/"}
    },
    "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "next_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "condition", "authority", "decision_ref"],
      "properties": {
        "target": {"enum": ["D", "E", "STOP", "TEMPORAL_REGION_PROOF", "EPISTEMIC_CONFLICT_PROOF"]},
        "authority": {"const": "explicit_owner_instruction"},
        "decision_ref": {"enum": ["docs/work/2026-09-19_GATE_E_EVIDENCE_RECOVERY_SPEC_v1.md", "docs/work/2026-09-23_GATE_E_OWNER_DIRECTED_CLOSEOUT_v1.md", "docs/work/2026-09-24_CONTEXTUAL_SNAPSHOT_CANDIDATE_SEARCH_CLOSEOUT_v1.md", "docs/work/2026-09-24_EPISTEMIC_CONFLICT_PROOF_AUTHORIZATION_v1.md"]},
        "condition": {"type": "string", "minLength": 1}
      }
    }
  }
}

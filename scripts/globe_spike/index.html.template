<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>ARTEMIS · Leonardo Life Path</title>
  <link rel="stylesheet" href="https://unpkg.com/maplibre-gl@5.24.0/dist/maplibre-gl.css" />
  <link rel="stylesheet" href="./style.css" />
</head>
<body>
  <main id="app">
    <section id="globe-shell" aria-label="ARTEMIS Leonardo life path globe">
      <div id="globe"></div>
      <header id="spike-banner">
        <div class="product-label">
          <strong>ARTEMIS · Leonardo Life Path</strong>
          <span>{{PUBLIC_PREVIEW_STATUS}}</span>
        </div>
        <div class="banner-actions">{{PUBLIC_PREVIEW_NAV}}</div>
      </header>
      <div id="attribution-status" class="map-note attribution-note"></div>
    </section>

    <aside id="inspector" aria-label="Leonardo life path controls and selected stop">
      <header class="subject-header">
        <span class="eyebrow">Selected object</span>
        <h1>Leonardo da Vinci</h1>
        <p id="path-coverage">Selected source-bound Romagna stops · 1502</p>
      </header>

      <section class="path-controls" aria-labelledby="time-mode-title">
        <div class="section-heading">
          <h2 id="time-mode-title">Explore through time</h2>
          <div class="mode-switch" role="group" aria-label="Timeline mode">
            <button id="mode-range" type="button" aria-pressed="true">Range</button>
            <button id="mode-journey" type="button" aria-pressed="false">Journey</button>
          </div>
        </div>

        <div id="range-controls" class="timeline-mode">
          <div class="range-row">
            <label for="range-start">Start</label>
            <output id="range-start-value" for="range-start">—</output>
            <input id="range-start" type="range" min="0" max="0" step="1" value="0" />
          </div>
          <div class="range-row">
            <label for="range-end">End</label>
            <output id="range-end-value" for="range-end">—</output>
            <input id="range-end" type="range" min="0" max="0" step="1" value="0" />
          </div>
          <p class="mode-help">Shows every selected stop inside the chosen source-bound interval.</p>
        </div>

        <div id="journey-controls" class="timeline-mode" hidden>
          <div class="range-row">
            <label for="journey-start">Begin at</label>
            <output id="journey-start-value" for="journey-start">—</output>
            <input id="journey-start" type="range" min="0" max="0" step="1" value="0" />
          </div>
          <div class="range-row">
            <label for="journey-current">Current stop</label>
            <output id="journey-current-value" for="journey-current">—</output>
            <input id="journey-current" type="range" min="0" max="0" step="1" value="0" />
          </div>
          <p class="mode-help">Progressively reveals the accumulated path from the chosen beginning.</p>
        </div>

        <p id="temporal-map-status" class="path-status" role="status" aria-live="polite">Loading source-bound stops…</p>
      </section>

      <section class="stop-sequence-section" aria-labelledby="stop-sequence-title">
        <h2 id="stop-sequence-title">Documented stops</h2>
        <div id="path-sequence" class="path-sequence" role="list"></div>
        <p class="route-note">The order is chronological. Exact routes between stops are unknown, so no route line is drawn.</p>
      </section>

      <section class="selection-section" aria-labelledby="selection-title">
        <span class="eyebrow">Selected stop</span>
        <h2 id="selection-title">Place details</h2>
        <div id="selection-card" class="selection-card empty" tabindex="-1" aria-live="polite">Choose a numbered stop on the globe or in the list.</div>
      </section>

      <details id="prototype-details" class="prototype-details">
        <summary>Sources, limits and prototype status</summary>
        <div class="prototype-body">
          <p class="source-note">Frozen repository review package. Claims remain draft/rejected; this preview does not query Airtable.</p>
          <dl class="metrics">
            <div><dt>Selected time</dt><dd id="selected-time">—</dd></div>
            <div><dt>World Slice</dt><dd id="world-slice">—</dd></div>
            <div><dt>Corpus status</dt><dd id="corpus-status">—</dd></div>
            <div><dt>Engine</dt><dd id="engine-status">loading</dd></div>
            <div><dt>Terrain</dt><dd id="terrain-status">—</dd></div>
            <div><dt>Startup</dt><dd id="startup-ms">pending</dd></div>
            <div><dt>Frame sample</dt><dd id="frame-sample">pending</dd></div>
          </dl>
          <p id="boundary-status" class="boundary-note"></p>
          <span id="explorer-state" hidden></span>
          <span id="projection-id" hidden></span>
          <span id="deferred-types" hidden></span>
          <span id="primitive-count" hidden></span>
        </div>
      </details>
    </aside>
  </main>

  <div id="fatal-error" role="alert" hidden></div>

  <script src="https://unpkg.com/maplibre-gl@5.24.0/dist/maplibre-gl.js"></script>
  <script src="./runtime.js"></script>
</body>
</html>

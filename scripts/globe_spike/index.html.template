<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>ARTEMIS Globe R&D Spike</title>
  <link rel="stylesheet" href="https://unpkg.com/maplibre-gl@5.24.0/dist/maplibre-gl.css" />
  <link rel="stylesheet" href="./style.css" />
</head>
<body>
  <main id="app">
    <section id="globe-shell" aria-label="ARTEMIS experimental 3D globe">
      <div id="globe"></div>
      <header id="spike-banner">
        <div>
          <strong>ARTEMIS · Source-aware 3D Globe MVP</strong>
          <span>{{PUBLIC_PREVIEW_STATUS}}</span>
        </div>
        <div class="banner-actions">
          {{PUBLIC_PREVIEW_NAV}}
          <div id="engine-status" class="status-pill">engine: loading</div>
        </div>
      </header>

      <div id="globe-controls" role="group" aria-label="Globe controls">
        <button id="view-global" type="button">Global</button>
        <button id="view-slice" type="button">World Slice</button>
        <button id="toggle-alternatives" type="button" aria-pressed="true" title="Renderer-local visibility for already projected alternative geometry" hidden>Map display: alternative geometry shown</button>
      </div>

      <div id="temporal-map-status" class="map-note temporal-map-note" role="status" aria-live="polite">Loading source-bound time view…</div>
      <div id="terrain-status" class="map-note"></div>
      <div id="attribution-status" class="map-note attribution-note"></div>
    </section>

    <aside id="inspector" aria-label="ARTEMIS globe spike inspector">
      <section aria-labelledby="explorer-controls-title">
        <h1 id="explorer-controls-title">Synchronized Explorer</h1>
        <p class="source-note">Data source: frozen repository review package. This preview does not query Airtable live.</p>
        <div class="explorer-control">
          <label for="temporal-preset">Source-bound date or interval</label>
          <input id="temporal-preset" type="range" min="0" max="0" step="1" value="0" aria-describedby="temporal-preset-value interaction-status" />
          <output id="temporal-preset-value" for="temporal-preset">Loading…</output>
        </div>
        <fieldset id="layer-controls" class="layer-controls">
          <legend>Active semantic layers</legend>
        </fieldset>
        <p id="interaction-status" class="hint" role="status" aria-live="polite">Loading deterministic Explorer views…</p>
      </section>

      <details class="inspector-disclosure">
        <summary>Shared state and data boundary</summary>
        <div class="disclosure-body">
          <dl class="metrics">
            <div><dt>World Slice</dt><dd id="world-slice">—</dd></div>
            <div><dt>Explorer State</dt><dd id="explorer-state">—</dd></div>
            <div><dt>Selected time</dt><dd id="selected-time">—</dd></div>
            <div><dt>Projection</dt><dd id="projection-id">—</dd></div>
            <div><dt>Corpus status</dt><dd id="corpus-status">—</dd></div>
            <div><dt>Deferred types</dt><dd id="deferred-types">—</dd></div>
          </dl>
          <p id="boundary-status" class="boundary-note">Loading semantic and renderer boundary…</p>
        </div>
      </details>

      <section>
        <h2>Semantic render</h2>
        <div id="semantic-summary" class="summary-grid"></div>
        <p class="hint">Pick a rendered object or choose an unresolved record. Both paths resolve the same canonical evidence chain.</p>
      </section>

      <section>
        <h2>Selection</h2>
        <div id="selection-card" class="selection-card empty" tabindex="-1" aria-live="polite">No semantic object selected.</div>
      </section>

      <details class="inspector-disclosure">
        <summary>Unresolved / uncertain · <span id="unresolved-count">0</span></summary>
        <div id="unresolved-list" class="disclosure-body"></div>
      </details>

      <details class="inspector-disclosure">
        <summary>Renderer and runtime diagnostics</summary>
        <div class="disclosure-body">
          <p class="warning">The dashed path is synthetic renderer-capability geometry only. It has no World Model object ID and is not historical knowledge.</p>
          <dl class="metrics">
            <div><dt>Startup → idle</dt><dd id="startup-ms">pending</dd></div>
            <div><dt>Frame sample</dt><dd id="frame-sample">pending</dd></div>
            <div><dt>Rendered semantic primitives</dt><dd id="primitive-count">—</dd></div>
          </dl>
        </div>
      </details>
    </aside>
  </main>

  <div id="fatal-error" role="alert" hidden></div>

  <script src="https://unpkg.com/maplibre-gl@5.24.0/dist/maplibre-gl.js"></script>
  <script src="./runtime.js"></script>
  <script>
    (() => {
      const params = new URLSearchParams(window.location.search);
      if (params.get('view') !== 'slice') return;

      let attempts = 0;
      const timer = window.setInterval(() => {
        attempts += 1;
        const map = window.__ARTEMIS_GLOBE_SPIKE?.map;
        if (
          map
          && typeof map.getLayer === 'function'
          && map.getLayer('artemis-region-primary-fill')
          && typeof window.__ARTEMIS_GLOBE_SPIKE?.focusSlice === 'function'
        ) {
          window.clearInterval(timer);
          window.__ARTEMIS_GLOBE_SPIKE.focusSlice();
          document.documentElement.dataset.artemisCamera = 'world-slice';
          return;
        }
        if (attempts >= 150) window.clearInterval(timer);
      }, 100);
    })();
  </script>
</body>
</html>

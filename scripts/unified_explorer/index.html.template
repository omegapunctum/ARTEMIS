<!doctype html>
<html lang="en" data-entry-profile="{{ENTRY_PROFILE}}" data-bundle-version="{{BUNDLE_SHA}}" data-context-version="{{CONTEXT_SHA}}">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><meta name="robots" content="noindex,nofollow"><title>ARTEMIS · Explorer</title><link rel="preconnect" href="https://unpkg.com" crossorigin><link rel="preload" href="./unified-bundle.json?v={{BUNDLE_SHA}}" as="fetch" crossorigin><link rel="preload" href="./earth-context.geojson?v={{CONTEXT_SHA}}" as="fetch" crossorigin><link rel="stylesheet" href="https://unpkg.com/maplibre-gl@5.24.0/dist/maplibre-gl.css"><link rel="stylesheet" href="./style.css?v={{STYLE_SHA}}"></head>
<body><main id="app">
  <div id="map" aria-label="ARTEMIS shared spatial explorer"></div>
  <header id="workspace-header">
    <div class="workspace-title"><strong>ARTEMIS · Explorer</strong><span data-i18n="preview">Public research prototype · user value unvalidated</span></div>
    <button id="mobile-settings" class="mobile-only" type="button" aria-controls="header-panels" aria-expanded="false">Menu</button>
    <div id="mobile-tools" class="mobile-only"><button id="mobile-layers" type="button" aria-controls="header-panels" aria-expanded="false">Layers</button><button id="mobile-records" type="button" aria-controls="header-panels" aria-expanded="false">Records</button></div>
    <div id="header-panels"><div class="mobile-panel-heading mobile-only"><strong id="header-panel-title"></strong><button id="header-close" type="button">Close</button></div><p id="workspace-context" class="mobile-only" data-i18n="preview">Public research prototype · user value unvalidated</p>
    <div class="presentation-controls"><div role="group" aria-label="Map view"><button id="view-globe" type="button" aria-pressed="true" disabled data-i18n="globe">Globe</button><button id="view-map" type="button" aria-pressed="false" disabled data-i18n="map">2D map</button></div><div role="group" aria-label="Language"><button id="language-en" type="button" aria-pressed="true">EN</button><button id="language-ru" type="button" aria-pressed="false">RU</button></div></div>
    <fieldset id="layer-controls"><legend data-i18n="layers">Layers</legend>
      <label><input id="layer-leonardo" type="checkbox" value="leonardo" checked disabled><span data-i18n="leonardo">Leonardo</span><small>1452–1519 · <span data-i18n="eleven">11 selected presences</span></small></label>
      <label><input id="layer-roman" type="checkbox" value="roman" checked disabled><span data-i18n="roman">Roman Empire</span><small>91–116 CE · <span data-i18n="three">3 reconstructions</span></small></label>
      <label><input id="layer-architecture" type="checkbox" value="architecture" disabled><span data-i18n="architecture">Architecture references</span><small data-i18n="atemporal">Atemporal · historical applicability unknown</small></label>
      <label><input id="layer-catalog" type="checkbox" value="catalog" checked disabled><span data-i18n="catalog">London architecture catalog</span><small data-i18n="catalogPilot">Selected pilot · 10 objects · London</small></label>
    </fieldset>
    <div id="layer-status" role="status" aria-live="polite"></div>
    <p id="search-hint" data-i18n="searchHint">Search filters this chooser only; the map and open record remain unchanged.</p>
    <div id="search-status" role="status" aria-live="polite"></div>
    <div class="record-picker"><label for="record-select" data-i18n="visible">Visible records</label><select id="record-select" disabled><option value="" data-i18n="choose">Choose a record</option></select></div>
    <p id="workspace-error" role="status" hidden></p>
    </div>
    <div class="record-search"><label for="record-search" data-i18n="search">Search names or QID</label><input id="record-search" type="search" maxlength="200" disabled aria-describedby="search-hint search-status"><button id="clear-search" type="button" disabled data-i18n="clearSearch">Clear search</button></div>
  </header>
  <aside id="desktop-records" class="desktop-only" aria-label="Records"><button id="records-toggle" type="button" aria-expanded="true" aria-controls="desktop-records-body">Records</button><div id="desktop-records-body"><div id="desktop-search"></div><div id="desktop-chooser"></div><details id="desktop-layers"><summary data-i18n="layers">Layers</summary><div id="desktop-layer-body"></div></details></div></aside>
  <aside id="inspector" aria-label="Selected record details" hidden>
    <header class="drawer-header"><h1 id="selection-title"></h1><button id="inspector-toggle" class="desktop-only" type="button" aria-expanded="true" aria-controls="selection-scope selection-facts place-episodes focus-selection record-disclosure sources-disclosure evidence-disclosure input-disclosure">Collapse</button><button id="close-details" type="button" aria-label="Close record details">×</button></header>
    <p id="selection-scope"></p><div id="selection-facts"></div><div id="place-episodes" hidden></div><button id="focus-selection" type="button" data-i18n="focus">Focus map on this record</button>
    <details id="record-disclosure"><summary data-i18n="recordDetails">Record details</summary><div id="selection-details"></div></details>
    <details id="sources-disclosure"><summary id="sources-summary"></summary><div id="selection-sources"></div></details>
    <details id="evidence-disclosure"><summary data-i18n="evidence">Claims, evidence and uncertainty</summary><div id="selection-evidence"></div></details>
    <details id="input-disclosure"><summary data-i18n="raw">Source-native input and provenance</summary><div id="selection-input"></div></details>
  </aside>
  <button id="attribution-toggle" class="mobile-only" type="button" aria-controls="attribution" aria-expanded="false">Map sources</button>
  <div id="attribution" class="map-note"></div>
  <section id="time-dock" aria-label="Shared calendar selection">
    <button id="dock-toggle" class="mobile-only" type="button" aria-controls="mobile-dock-extras mobile-dock-actions" aria-expanded="false"><span id="dock-toggle-label">Expand</span></button>
    <span id="mobile-time-summary" class="mobile-only visually-hidden" aria-live="polite"></span>
    <div id="mobile-dock-extras"><div class="time-heading"><div role="group" aria-label="Timeline mode"><button id="mode-range" type="button" aria-pressed="true" data-i18n="range">Range</button><button id="mode-scrub" type="button" aria-pressed="false" data-i18n="scrub">Scrub</button></div><nav aria-label="Named time intervals"><button id="period-roman" type="button">91–116 CE</button><button id="period-leonardo" type="button">1452–1519</button><button id="period-all" type="button">91–1519</button></nav></div></div>
    <div id="range-controls"><label class="native-year" for="time-start"><span data-i18n="from">From</span><input id="time-start" type="number" min="91" max="1519" value="1452"></label><div id="mobile-range-start" class="year-wheel mobile-only" role="spinbutton" tabindex="0" aria-label="Interval start year CE" aria-valuemin="91" aria-valuemax="1519" aria-valuenow="1452"><span class="wheel-prev" aria-hidden="true"></span><span class="wheel-value" aria-hidden="true">1452</span><span class="wheel-next" aria-hidden="true"></span></div><div class="dual-range"><input id="range-start-handle" type="range" min="91" max="1519" value="1452" aria-label="Interval start year CE"><input id="range-end-handle" type="range" min="91" max="1519" value="1519" aria-label="Interval end year CE"></div><div id="mobile-range-end" class="year-wheel mobile-only" role="spinbutton" tabindex="0" aria-label="Interval end year CE" aria-valuemin="91" aria-valuemax="1519" aria-valuenow="1519"><span class="wheel-prev" aria-hidden="true"></span><span class="wheel-value" aria-hidden="true">1519</span><span class="wheel-next" aria-hidden="true"></span></div><label class="native-year" for="time-end"><span data-i18n="to">To</span><input id="time-end" type="number" min="91" max="1519" value="1519"></label></div>
    <div id="scrub-controls" hidden><label class="native-year" for="cursor-year" data-i18n="cursor">Current year CE</label><input class="native-year" id="cursor-year" type="number" min="91" max="1519" value="1519"><div id="mobile-cursor-year" class="year-wheel mobile-only" role="spinbutton" tabindex="0" aria-label="Current year CE" aria-valuemin="91" aria-valuemax="1519" aria-valuenow="1519"><span class="wheel-prev" aria-hidden="true"></span><span class="wheel-value" aria-hidden="true">1519</span><span class="wheel-next" aria-hidden="true"></span></div><input id="time-cursor" type="range" min="91" max="1519" value="1519" aria-label="Shared year cursor"></div>
    <div id="mobile-dock-actions" class="mobile-only"><button id="mobile-cancel" type="button">Cancel</button><button id="mobile-apply" type="button" disabled>Apply</button></div>
    <p id="time-status" role="status" aria-live="polite"></p><p id="route-note" data-i18n="routes">Leonardo chronology is not a travel route; exact routes and historical positions remain unknown.</p>
  </section>
  <div id="fatal-error" role="alert" hidden></div>
</main><script src="https://unpkg.com/maplibre-gl@5.24.0/dist/maplibre-gl.js"></script><script src="./mobile.js?v={{MOBILE_SHA}}"></script><script src="./desktop.js?v={{DESKTOP_SHA}}"></script><script src="./runtime.js?v={{RUNTIME_SHA}}"></script></body></html>

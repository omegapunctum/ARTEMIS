# ARTEMIS public API validation environment
# Copy these names into the hosting provider's secret/configuration store.
# Never commit real secret values.

# Runtime
APP_ENV=production
PORT=8000
ARTEMIS_LOG_LEVEL=INFO
HEALTH_ERROR_DECAY_SECONDS=120

# One-instance validation contour: this instance owns startup migrations.
MIGRATION_STARTUP_ROLE=owner

# Authentication
AUTH_SECRET_KEY=replace-with-a-long-random-secret
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_SESSION_BACKEND=redis
REDIS_URL=redis://replace-with-managed-redis-url

# Persistent single-writer SQLite volume mounted at /runtime.
AUTH_DATABASE_URL=sqlite:////runtime/artemis.db
UPLOADS_DIR=/runtime/uploads

# GitHub Pages and the API are cross-site. Refresh cookies therefore require
# Secure + SameSite=None. Keep COOKIE_DOMAIN unset for a host-only cookie.
COOKIE_HTTPONLY=true
COOKIE_SECURE=true
COOKIE_SAMESITE=none
COOKIE_PATH=/

# Exact origin only; paths such as /ARTEMIS/ do not belong in a CORS origin.
CORS_ALLOW_ORIGINS=https://omegapunctum.github.io

# Replace with the provider's documented proxy CIDR/IP list before trusting
# X-Forwarded-For. Leave unset rather than guessing.
# ARTEMIS_TRUSTED_PROXIES=10.0.0.0/8
